// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  analyses          Analysis[]
  jobApplications   JobApplication[]
  interviewSessions InterviewSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Análise feita por usuário anônimo, guardada temporariamente até ele fazer
// login e "reivindicar" o resultado completo (ver lib/analysis-store.ts).
// Persistida em banco (não em memória) para funcionar em ambientes com
// múltiplas instâncias/serverless. Uso único: apagada ao ser reivindicada.
model PendingAnalysis {
  id                 String   @id @default(cuid())
  resumeText         String   @db.Text
  jobDescriptionText String   @db.Text
  result             Json
  createdAt          DateTime @default(now())

  @@index([createdAt])
}

model Analysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeText         String @db.Text
  jobDescriptionText String @db.Text

  score            Int
  summary          String   @db.Text
  keywordsMatched  String[]
  keywordsMissing  String[]
  strengths        String[]
  weaknesses       String[]
  improvementTips  String[]
  interviewTips    String[]
  studySuggestions String[]

  // Array de { question: string, type: "technical" | "behavioral" }
  interviewQuestions Json

  recommendationVerdict   String
  recommendationReasoning String @db.Text

  // AdaptedResume (ver lib/gemini.ts), gerado sob demanda ao baixar o currículo adaptado
  adaptedResume Json?

  createdAt DateTime @default(now())

  jobApplications   JobApplication[]
  interviewSessions InterviewSession[]

  @@index([userId])
}

// Status possíveis (ver lib/job-application.ts): applied, in_process,
// interview, positive_response, rejected. Mantido como String, não enum do
// Prisma, para seguir o mesmo padrão de recommendationVerdict acima.
model JobApplication {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Análise (CV + vaga) que originou esta candidatura, se houver.
  analysisId String?
  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  company String
  role    String
  status  String  @default("applied")
  jobUrl  String?
  notes   String? @db.Text

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([analysisId])
}

// Simulador de entrevista (ver lib/gemini.ts): a IA assume o papel de
// entrevistador, usando a vaga e o currículo da análise vinculada como
// contexto, e ao final gera um feedback estruturado sobre o desempenho.
model InterviewSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  analysisId String?
  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  // Snapshot do contexto da análise de origem no momento da criação, para a
  // entrevista continuar funcionando mesmo que a análise seja excluída depois
  // (onDelete: SetNull acima) e para não precisar buscá-la a cada turno.
  resumeText         String   @db.Text
  jobDescriptionText String   @db.Text
  strengths          String[]
  weaknesses         String[]

  // Array de { role: "user" | "model", content: string }, em ordem
  // cronológica — mesmo formato aceito pela API do Gemini para histórico
  // de conversa multi-turno.
  messages Json

  feedbackSummary          String?  @db.Text
  feedbackStrengths        String[]
  feedbackImprovementAreas String[]
  feedbackRating           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([analysisId])
}
