# Copie este arquivo para ".env" e preencha os valores reais.
# Nunca commite o arquivo ".env" com valores reais.

# Banco de dados PostgreSQL (Supabase ou Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/matchcv?schema=public"

# Google Gemini API
GEMINI_API_KEY=""

# Auth.js (NextAuth) - login com Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Auth.js - chave usada para assinar/criptografar sessões e tokens
# Gere uma com: npx auth secret
AUTH_SECRET=""
